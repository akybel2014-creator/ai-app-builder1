# Variabili d'ambiente per AI App Builder

# Porta del server (default 3000)
PORT=3000

# URL pubblico canonico (opzionale; se vuoto usa l'host della richiesta)
APP_URL=

# Password amministratore per /admin.
# OBBLIGATORIA in produzione (NODE_ENV=production): senza, l'accesso admin e' disabilitato.
# Solo in sviluppo, se vuota, il login demo accetta "admin" o passphrase vuota.
ADMIN_PASSWORD=
